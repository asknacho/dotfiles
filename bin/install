#!/usr/bin/env bash
#
# install — bootstrap asknacho/dotfiles on a new machine.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/asknacho/dotfiles/main/bin/install | bash
#   bash bin/install                              # from a clone
#   bash bin/install --with-secrets <git-url>     # also clone+link a private secrets castle
#
# Idempotent — safe to re-run.

set -euo pipefail

DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/asknacho/dotfiles.git}"
HOMESHICK_REPO="https://github.com/andsens/homeshick.git"
HOMESHICK_DIR="$HOME/.homesick/repos/homeshick"
DOTFILES_DIR="$HOME/.homesick/repos/dotfiles"

SECRETS_REPO=""
SKIP_BREW=0

# ── argument parsing ────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --with-secrets)
      SECRETS_REPO="${2:-}"
      [[ -z "$SECRETS_REPO" ]] && { echo "--with-secrets requires a git URL"; exit 1; }
      shift 2
      ;;
    --skip-brew)
      SKIP_BREW=1
      shift
      ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

# ── helpers ─────────────────────────────────────────────────────────────────
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ── 1. mandatory deps ───────────────────────────────────────────────────────
have git  || die "git is required. Install Xcode Command Line Tools or your distro's git package."
have curl || die "curl is required."

# ── 2. homeshick ────────────────────────────────────────────────────────────
if [[ ! -d "$HOMESHICK_DIR" ]]; then
  log "cloning homeshick → $HOMESHICK_DIR"
  git clone --depth=1 "$HOMESHICK_REPO" "$HOMESHICK_DIR"
else
  log "homeshick already present"
fi

# shellcheck source=/dev/null
source "$HOMESHICK_DIR/homeshick.sh"

# ── 3. dotfiles castle ──────────────────────────────────────────────────────
if [[ ! -d "$DOTFILES_DIR" ]]; then
  log "cloning dotfiles castle"
  homeshick --batch clone "$DOTFILES_REPO"
else
  log "dotfiles castle already present — pulling latest"
  homeshick --batch pull dotfiles
fi
log "linking dotfiles castle"
homeshick --force --batch link dotfiles

# ── 4. secrets castle (optional) ────────────────────────────────────────────
if [[ -n "$SECRETS_REPO" ]]; then
  SECRETS_NAME="${SECRETS_REPO##*/}"
  SECRETS_NAME="${SECRETS_NAME%.git}"
  SECRETS_DIR="$HOME/.homesick/repos/$SECRETS_NAME"

  if [[ ! -d "$SECRETS_DIR" ]]; then
    log "cloning secrets castle → $SECRETS_DIR"
    homeshick --batch clone "$SECRETS_REPO"
  else
    log "secrets castle '$SECRETS_NAME' already present — pulling latest"
    homeshick --batch pull "$SECRETS_NAME"
  fi
  log "linking secrets castle"
  homeshick --force --batch link "$SECRETS_NAME"
fi

# ── 5. homebrew bundle (macOS) ──────────────────────────────────────────────
if [[ "$SKIP_BREW" -eq 0 && "$(uname -s)" == "Darwin" ]]; then
  if ! have brew; then
    warn "Homebrew not installed. Install from https://brew.sh and re-run, or use --skip-brew."
  else
    if [[ -f "$DOTFILES_DIR/Brewfile" ]]; then
      log "running brew bundle (public Brewfile)"
      brew bundle --file="$DOTFILES_DIR/Brewfile"
    fi
    # also run secrets castle Brewfile if present
    if [[ -n "$SECRETS_REPO" && -f "$SECRETS_DIR/Brewfile" ]]; then
      log "running brew bundle (secrets Brewfile)"
      brew bundle --file="$SECRETS_DIR/Brewfile"
    fi
  fi
fi

# ── 6. optional-tool warnings ───────────────────────────────────────────────
have nvim         || warn "neovim not found — install via brew/apt/etc."
have tmux         || warn "tmux not found — install via brew/apt/etc."
have fzf          || warn "fzf not found — mux picker will fall back to plain prompt."
have rg           || warn "ripgrep not found — telescope live_grep won't work."
have mise         || warn "mise not found — runtime version manager not available."
have direnv       || warn "direnv not found — per-project env hooks won't work."
have tree-sitter  || warn "tree-sitter CLI not found — some parser builds may fail."

# ── 7. tmux + nvim plugin bootstraps ────────────────────────────────────────
# tmux's TPM and nvim's lazy.nvim both auto-install on first launch
# (see ~/.config/tmux/tmux.conf and ~/.config/nvim/lua/config/lazy.lua).
log "tmux/nvim plugins will auto-install on first launch."

# ── 8. next steps ───────────────────────────────────────────────────────────
cat <<'EOF'

Done.

Next steps:
  • If zsh isn't your default shell yet:
        chsh -s "$(command -v zsh)"
  • Open a new shell, or:  exec zsh
  • First nvim launch will install lazy.nvim + plugins.
  • First tmux launch will install TPM + plugins.
EOF
