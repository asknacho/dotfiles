# Brewfile — public dotfile dependencies
# Install with: brew bundle --file=Brewfile
#
# Personal/machine-specific packages belong in a separate Brewfile.local
# (e.g. inside the secrets castle).

# Core
brew "git"
brew "curl"
brew "zsh"

# Editor + terminal multiplexer
brew "neovim"
brew "tmux"

# Search / fuzzy find
brew "fzf"
brew "ripgrep"
brew "the_silver_searcher"

# Runtime / env management
brew "mise"
brew "direnv"

# Build deps for nvim-treesitter parsers
brew "gcc"
brew "tree-sitter"

# GNU date (gdate) — required by from_ts/to_ts scripts
brew "coreutils"

# PostgreSQL clients — required by awshelp database command
brew "postgresql@16"
brew "pgcli"

# Ruby (used by zshrc PATH override)
brew "ruby"
